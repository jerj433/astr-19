   "id": "4be3b1cd",
   "metadata": {},
   "outputs": [],
   "source": [
    "data = np.random.poisson(lam=3.0, size=1000)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "de8dc662",
   "metadata": {},
   "outputs": [],
   "source": [
